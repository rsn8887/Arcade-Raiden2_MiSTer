# ROMs -- NEVER commit. MRAs reference MAME zips by CRC only.
*.zip
*.rom
roms/*

# MiSTer SD-card runtime artefacts, not source: the board writes per-core
# settings into cfg/ and screenshots into snap/. No reference core ships
# either (checked against Arcade-IremM92, Arcade-IremM72, Arcade-Raiden).
cfg/
snap/

# Simulation
*.vcd
*.fst
obj_dir/

# Project notes are kept in the development tree, not shipped. The README is
# the single document for this repository.
#
# rtl/sound/jt51/README.md is NOT ignored: it is the vendored JT51 core's own
# readme and carries its attribution, which a GPL component must keep.
docs/
/*.md
!/README.md

# Build logs from ad-hoc compiles (compile.log is Quartus' own, above)
compile_*.log

# Python bytecode from tools/
__pycache__/
