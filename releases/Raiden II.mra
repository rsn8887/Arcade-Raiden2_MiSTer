<misterromdescription>
  <name>Raiden II</name>
  <setname>raiden2</setname>
  <mameversion>0264</mameversion>
  <rbf>Raiden2</rbf>
  <year>1993</year>
  <manufacturer>Seibu Kaihatsu</manufacturer>
  <category>Shoot</category>
  <rotation>vertical</rotation>
  <resolution>15kHz</resolution>
  <players>2</players>
  <joystick>8-way</joystick>
  <num_buttons>2</num_buttons>
  <!-- Names are positional and must mirror the CONF_STR "J1,..." list in
       Raiden2.sv, dashes included, or the OSD labels drift off the joystick
       bits. Defaults map to the non-dash names in order (joymapping.cpp
       skips a "-" without advancing the default index), so this reads
       Fire=A, Bomb=B, Auto Fire=X, Start=R, Coin=L, Pause=Start.

       That is the Arcade-Cave_MiSTer convention (Start on R, Coin on L,
       Pause on Start), which previously left Coin and Pause unmapped here.

       Auto Fire is NOT on the Raiden II board. num_buttons stays 2 because
       that field describes the PCB, and MAME has bit 0x0040 as IPT_UNUSED
       for raiden2 where raidendx PORT_MODIFYs it to BUTTON3. The button is
       here because the core synthesises the repeat that the DX program
       provides in software; see the auto fire block in Raiden2.sv. Held,
       not toggled, and identical in layout to Raiden DX so the two games
       play the same way. -->
  <buttons names="Fire,Bomb,Auto Fire,-,-,-,Start,Coin,-,Pause"
           default="A,B,X,R,L,Start"/>

  <!-- DIP layout from MAME raiden2.cpp INPUT_PORTS_START(raiden2).
       All switches are active low, so the default of FF,FF is
       1C_1C / 1C_1C, Normal starting coin, Flip off, Normal difficulty,
       3 lives, 200000/500000 bonus, Demo sounds on. -->
  <switches default="FF,FF">
    <dip bits="0,2"   ids="Free Play,4C 1C,3C 1C,1C 4C,2C 1C,1C 3C,1C 2C,1C 1C" name="Coin A"/>
    <dip bits="3,5"   ids="Free Play,4C 1C,3C 1C,1C 4C,2C 1C,1C 3C,1C 2C,1C 1C" name="Coin B"/>
    <dip bits="6"     ids="X 2,Normal" name="Starting Coin"/>
    <dip bits="7"     ids="On,Off" name="Flip Screen"/>
    <dip bits="8,9"   ids="Very Hard,Hard,Easy,Normal" name="Difficulty"/>
    <dip bits="10,11" ids="1,4,2,3" name="Lives"/>
    <dip bits="12,13" ids="No Extend,1000000 3000000,400000 1000000,200000 500000" name="Bonus Life"/>
    <dip bits="14"    ids="Off,On" name="Demo Sounds"/>
    <!-- SW2:8, the board's own service/test menu:
           PORT_SERVICE( 0x8000, IP_ACTIVE_LOW ) PORT_DIPLOCATION("SW2:!8")
         Active low like every other switch here, so "Off" is the FF default
         and "On" enters the test menu on the next reset. -->
    <dip bits="15"    ids="On,Off" name="Test Mode"/>
  </switches>

  <!-- ============================================================
       SDRAM layout. Must match tools/build_rom.py and the base
       addresses in Raiden2.sv:

         0x000000  maincpu    1 MB    prg0/prg1 byte-interleaved
         0x100000  audiocpu   128 KB  snd, with the CONTINUE/COPY
                                      rearrangement MAME's ROM_START does
         0x120000  chars      128 KB
         0x140000  copx       256 KB
         0x180000  oki1       256 KB
         0x1C0000  oki2       256 KB
         0x200000  tiles      4 MB
         0x600000  sprites    8 MB    (decrypted in RTL by r2crypt as it
                                      is fetched, not by the loader)

       Total 14 MB. Note the background ROMs: the u-numbers read as though
       they were transposed, but this is what MAME 0.264 has. Verified
       against the mame0264 tag of raiden2.cpp and against the set itself:
       bg-1 is u0714, bg-2 is u075, and e61ad38e goes first.
       These names were transposed until 2026-08-11, which went unnoticed
       because MiSTer resolves a part by CRC32 first and only falls back to
       the filename (file_io.cpp FileOpenZip), so the correct CRCs kept
       loading the right data under the wrong names.
       ============================================================ -->
  <!-- Game select, read by the core at ioctl index 1, and it MUST come BEFORE
       index 0. Sprites are decrypted inline as the index-0 stream arrives and
       the decrypt window is per-game, so the core has to know the map before
       the first sprite byte lands. 00 = Raiden II, 01 = Raiden DX. Stating it
       explicitly is what lets the core drop its old clear-on-index-0 guard,
       which would now wipe the value index 1 has just set. -->
  <rom index="1">
    <part>00</part>
  </rom>

  <rom index="0" zip="raiden2.zip" md5="None">

    <!-- maincpu 0x000000, 1 MB: ROM_LOAD16_BYTE even/odd -->
    <interleave output="16">
      <part name="prg0.u0211" crc="09475ec4" map="01"/>
      <part name="prg1.u0212" crc="4609b5f2" map="10"/>
    </interleave>

    <!-- audiocpu 0x100000, 128 KB. MAME does:
           ROM_LOAD  snd 0x0000 len 0x8000  -> region 0x00000
           ROM_CONTINUE            len 0x8000 -> region 0x10000
           ROM_COPY  region 0x0000 len 0x8000 -> region 0x18000
         which gives the Seibu Z80 layout: fixed low bank at 0, two
         selectable high banks at 0x10000 / 0x18000. -->
    <part name="snd.u1110" crc="f51a28f9" offset="0x0000" length="0x8000"/>
    <part repeat="0x8000">FF</part>
    <part name="snd.u1110" crc="f51a28f9" offset="0x8000" length="0x8000"/>
    <part name="snd.u1110" crc="f51a28f9" offset="0x0000" length="0x8000"/>

    <!-- chars 0x120000, 128 KB -->
    <part name="seibu7.u0724" crc="c9ec9469"/>

    <!-- copx 0x140000, 256 KB. COP data ROM; format unknown and unused. -->
    <part name="copx-d2.u0313" crc="a6732ff9"/>

    <!-- oki1 0x180000 / oki2 0x1C0000, 256 KB each -->
    <part name="seibu6.u1017" crc="fb0fca23"/>
    <part name="raiden_2_pcm.u1018" crc="8cf0d17e"/>

    <!-- tiles 0x200000, 4 MB -->
    <part name="raiden_2_seibu_bg-1.u0714" crc="e61ad38e"/>
    <part name="raiden_2_seibu_bg-2.u075" crc="a694a4bb"/>

    <!-- sprites 0x600000, 8 MB: ROM_REGION32_LE + ROM_LOAD32_WORD.
         obj-1/obj-2 are the low/high 16-bit halves of each dword for the
         first 4 MB, obj-3/obj-4 for the second. -->
    <interleave output="32">
      <part name="raiden_2_seibu_obj-1.u0811" crc="ff08ef0b" map="0021"/>
      <part name="raiden_2_seibu_obj-2.u082"  crc="638eb771" map="2100"/>
    </interleave>
    <interleave output="32">
      <part name="raiden_2_seibu_obj-3.u0837" crc="897a0322" map="0021"/>
      <part name="raiden_2_seibu_obj-4.u0836" crc="b676e188" map="2100"/>
    </interleave>
  </rom>

  <!-- DIP switches arrive on index 254 -->
  <rom index="254" zip="raiden2.zip" type="nvram" md5="None">
    <part>FF FF</part>
  </rom>
</misterromdescription>
